{
  "name": "emotions-challenge-desktop",
  "version": "1.0.2",
  "description": "Desafio das Emoções + IA - Desktop Application",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "build": "electron-builder",
    "build-all": "electron-builder -mwl",
    "publish": "electron-builder --publish always",
    "dist": "npm run build"
  },
  "keywords": [
    "emotions",
    "ai",
    "face-detection",
    "education",
    "desktop",
    "electron"
  ],
  "author": {
    "name": "UFP",
    "email": "contact@ufp.edu.pt"
  },
  "license": "MIT",
  "config": {
    "kioskMode": false
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.0.1"
  },
  "build": {
    "appId": "com.ufp.emotionschallenge",
    "productName": "Desafio das Emoções + IA",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "app.js",
      "index.html",
      "style.css",
      "server.js",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "./models",
        "to": "models"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "csoares",
        "repo": "SantoTirsoChallenge"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csoares/SantoTirsoChallenge.git"
  }
}
