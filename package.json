{
  "name": "emotions-challenge-desktop",
  "version": "2.0.0",
  "description": "Desafio das Emoções + IA - Desktop Application",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "build": "electron-builder",
    "build-all": "electron-builder -mwl",
    "publish": "electron-builder --publish always",
    "dist": "npm run build"
  },
  "keywords": [
    "emotions",
    "ai",
    "face-detection",
    "education",
    "desktop",
    "electron"
  ],
  "author": {
    "name": "UFP",
    "email": "contact@ufp.edu.pt"
  },
  "license": "MIT",
  "config": {
    "kioskMode": false
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.0.1"
  },
  "build": {
    "appId": "com.ufp.emotionschallenge",
    "productName": "Emotions Challenge",
    "directories": {
      "output": "dist-electron"
    },
    "afterPack": "build/adhoc-sign.js",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "assets/favicon.png",
      "app.js",
      "config.js",
      "index.html",
      "style.css",
      "server.js",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "./models",
        "to": "models"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Esta aplicação necessita de acesso à câmara para detetar expressões faciais.",
        "NSMicrophoneUsageDescription": "Esta aplicação pode necessitar de acesso ao microfone."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "csoares",
        "repo": "ArtificialIntelligenceGame",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csoares/ArtificialIntelligenceGame.git"
  }
}
